# HANA CAREER COMPANION — ENVIRONMENT CONFIGURATION

# Authentication & session
VITE_APP_ID=
JWT_SECRET=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=

# Persistence
DATABASE_URL=

# AI / computational services (server-only unless explicitly prefixed VITE_)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
WOLFRAM_APP_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Free Gemini fallback (server-only; obtain a Gemini API key from Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional frontend Forge configuration
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# Optional analytics. Leave both empty to disable analytics.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Runtime
# NODE_ENV=development
# PORT=3000

# Notes:
# - Never commit a real secret or API key to Git.
# - OPENAI_API_KEY, GEMINI_API_KEY, WOLFRAM_APP_ID, DATABASE_URL and Forge secrets are server-only.
# - OPENAI_API_KEY powers Hana's primary chat and web research through the OpenAI Responses API.
# - GEMINI_API_KEY is the fallback when OpenAI is unavailable.
# - WOLFRAM_APP_ID is used for computational questions when configured.
# - DATABASE_URL enables durable learner-owned records; without it the app uses graceful empty/demo behavior.
