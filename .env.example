# Client-visible application identifier used by the authentication scaffold.
VITE_APP_ID=

# Server-only session and persistence configuration.
JWT_SECRET=
DATABASE_URL=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Server-only built-in Forge configuration for Hana AI and storage.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Server-only Wolfram|Alpha AppID. Never expose this as VITE_WOLFRAM_APP_ID.
WOLFRAM_APP_ID=

# Optional client analytics configuration.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
