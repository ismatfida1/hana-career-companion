# ═══════════════════════════════════════════════════════════════════════════════
# HANA CAREER COMPANION — ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED: AUTHENTICATION & SESSION
# ─────────────────────────────────────────────────────────────────────────────

# Client-visible application identifier for Manus OAuth (authentication service).
# Contact your deployment team for your project's app ID.
VITE_APP_ID=

# Server-only secret key used to sign JWT session tokens.
# Use a cryptographically secure random string (minimum 32 characters recommended).
# Command: `openssl rand -hex 16` for a 32-character key
JWT_SECRET=

# URL of the OAuth authorization server for user authentication.
# Example: https://auth.manus.ai/oauth
# Required for user login and session management.
OAUTH_SERVER_URL=

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED: DATABASE & PERSISTENCE
# ─────────────────────────────────────────────────────────────────────────────

# MySQL connection string for learner profiles, projects, portfolio drafts, and chat.
# Format: mysql://user:password@host:port/database?ssl=true
# The app gracefully handles missing database by using demo data.
DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL: AI & EXTERNAL SERVICES
# ─────────────────────────────────────────────────────────────────────────────

# Server-only Wolfram|Alpha AppID for computational queries and math help.
# Request at: https://www.wolframalpha.com/widgets/
# Never expose this as VITE_WOLFRAM_APP_ID (server-only security requirement).
# If not set, Wolfram features gracefully degrade in chat.
WOLFRAM_APP_ID=

# Built-in Forge API URL for Hana's AI backend (chat, portfolio generation, help).
# When provided, enables LLM-powered features.
# If not set, chat uses simplified responses and portfolio drafts are static templates.
BUILT_IN_FORGE_API_URL=

# Server-only API key for built-in Forge API authentication.
# Required only if BUILT_IN_FORGE_API_URL is configured.
BUILT_IN_FORGE_API_KEY=

# Client-side Forge API for frontend features (if using separate frontend Forge instance).
# If not set, frontend features degrade gracefully.
VITE_FRONTEND_FORGE_API_URL=

# Client-visible API key for frontend Forge requests.
# If not set, frontend features degrade gracefully.
VITE_FRONTEND_FORGE_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL: AUTHENTICATION PORTAL
# ─────────────────────────────────────────────────────────────────────────────

# URL of the user authentication portal for profile management and sign-in.
# Example: https://auth.manus.ai/
# If not set, authentication scaffold still works but uses default behavior.
VITE_OAUTH_PORTAL_URL=

# Server-only owner identifier for admin operations (internal use only).
# Optional; used for privileged learner profile or system diagnostics.
OWNER_OPEN_ID=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL: ANALYTICS & MONITORING
# ─────────────────────────────────────────────────────────────────────────────

# Analytics service endpoint for usage tracking (client-visible).
# Example: https://analytics.example.com
# Injected into client/index.html for performance monitoring.
# If not set, analytics script is skipped (no errors).
VITE_ANALYTICS_ENDPOINT=

# Analytics service website ID for identifying this deployment.
# Required only if VITE_ANALYTICS_ENDPOINT is configured.
# Used with Umami or similar analytics platforms.
VITE_ANALYTICS_WEBSITE_ID=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL: RUNTIME
# ─────────────────────────────────────────────────────────────────────────────

# Node environment ("development" or "production").
# Defaults to "development" for local dev, should be "production" in deployment.
# NODE_ENV=development

# Server port for local development (defaults to 3000).
# PORT=3000
