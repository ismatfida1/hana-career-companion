# HANA CAREER COMPANION — ENVIRONMENT CONFIGURATION

# Authentication & session
VITE_APP_ID=
JWT_SECRET=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=

# Persistence
DATABASE_URL=

# AI / computational services (server-only unless explicitly prefixed VITE_)
WOLFRAM_APP_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional frontend Forge configuration
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# Optional analytics. Leave both empty to disable analytics.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Runtime
# NODE_ENV=development
# PORT=3000

# Notes:
# - Never commit a real secret or API key to Git.
# - WOLFRAM_APP_ID is server-only and must not be exposed through Vite/client variables.
# - DATABASE_URL is required for durable learner-owned records; without it the app uses graceful empty/demo behavior.
# - BUILT_IN_FORGE_API_* are server-side configuration values.
